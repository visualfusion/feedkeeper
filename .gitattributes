# Auto-detect text files and normalize line endings to LF
* text=auto

# TypeScript & JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Web, Markup & Styling
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.sql text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.pdf binary
*.sqlite binary
*.db binary

# Fonts
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
