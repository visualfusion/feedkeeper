# Copy this file to .env and fill in real values before starting Feedkeeper.

# Port the Node process listens on.
PORT=3000

# The public URL users reach this instance at (used for CORS and secure cookies).
PUBLIC_URL=https://rss.visualfusion.de

# Where the SQLite database file is stored.
DATABASE_PATH=./data/feedkeeper.sqlite

# Long, random secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Whether new users can self-register via the web UI. Keep this "false" on a
# publicly reachable instance; an admin can always create accounts manually.
ALLOW_SIGNUP=false

# Set to "true" if Feedkeeper runs behind a reverse proxy (e.g. Uberspace's
# web server) so Express trusts X-Forwarded-* headers.
TRUST_PROXY=true

# Minimum allowed polling interval per feed, in minutes. Protects feed
# sources from being hammered by overly aggressive settings.
MIN_POLL_INTERVAL_MINUTES=5
