# Copy this file to .env and fill in real values before starting Feedkeeper.

# Port the Node process listens on.
PORT=3000

# The public URL users reach this instance at (used for CORS and secure cookies).
PUBLIC_URL=http://localhost:3000

# Where the SQLite database file is stored.
DATABASE_PATH=./data/feedkeeper.sqlite

# Where images of saved articles are stored. Defaults to an "archive" folder
# next to the database. Back it up together with the database.
# ARCHIVE_PATH=./data/archive

# Long, random secret (32+ characters) used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Allow feeds hosted on the same machine or private network. Only enable this
# for instances where every account is trusted to access those addresses.
ALLOW_PRIVATE_FEEDS=false

# Whether new users can self-register via the web UI. Keep this "false" on a
# publicly reachable instance; an admin can always create accounts manually.
ALLOW_SIGNUP=false

# Set to "true" if Feedkeeper runs behind one reverse proxy (e.g. Uberspace's
# web server) so Express trusts its X-Forwarded-* headers. Behind several proxies,
# such as a CDN in front of that web server, list every trusted proxy instead:
# addresses, CIDR ranges or "loopback", "linklocal", "uniquelocal", separated by
# commas. Rate limits then see the real client address, and requests that bypass
# the CDN cannot fake one. A number trusts that many hops.
TRUST_PROXY=false

# Header with the client address set by a CDN, e.g. CF-Connecting-IP for Cloudflare.
# Needed when the web server in front of the app replaces X-Forwarded-For with the
# CDN edge (Uberspace does). Used only for requests from the proxies listed in
# TRUST_PROXY, so clients that bypass the CDN cannot set it themselves.
CLIENT_IP_HEADER=

# Minimum allowed polling interval per feed, in minutes. Protects feed
# sources from being hammered by overly aggressive settings.
MIN_POLL_INTERVAL_MINUTES=5

# Bounded feed polling, discovery and icon requests; one application process per DB.
# See docs/feed-polling.md for settings, logs and upgrade guidance.
# Push uses a separate durable outbox: one device at a time, 10-second deadline.
POLL_CONCURRENCY=4
POLL_HOST_CONCURRENCY=2
POLL_MAX_WAITERS=64
POLL_REQUEST_TIMEOUT_MS=15000
POLL_ATTEMPT_TIMEOUT_MS=30000
POLL_MAX_RETRIES=2
POLL_RETRY_BASE_MS=5000
POLL_RETRY_MAX_MS=300000
POLL_TICK_MS=1000

# Database retention and housekeeping (can also be managed in Web UI -> Settings)
# Days to keep read items before purging (0 = immediately once read by all subscribers)
RETENTION_READ_DAYS=30
# Maximum age in days for any items (0 = keep indefinitely)
RETENTION_MAX_DAYS=90
# Maximum items to keep per feed (0 = keep unlimited items per feed)
RETENTION_MAX_ITEMS_PER_FEED=1000
# Whether to run automated daily housekeeping at 03:00 AM (true/false)
AUTO_CLEANUP_ENABLED=true

# Show a subtle GitHub link below the login box (true/false)
SHOW_GITHUB_LINK=true
# Custom repository URL for the login link (optional)
# GITHUB_URL=https://github.com/visualfusion/feedkeeper

# Optional: limit which hosts may register OAuth redirect addresses for MCP connectors
# (comma-separated, e.g. chatgpt.com,claude.ai). Empty allows any https host; localhost is always allowed.
# OAUTH_ALLOWED_REDIRECT_HOSTS=
