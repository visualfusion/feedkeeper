      "schemes": [
        "https://*.youtube.com/watch*",
        "https://*.youtube.com/v/*",
        "https://youtu.be/*",
        "https://*.youtube.com/playlist?list=*",
        "https://youtube.com/playlist?list=*",
        "https://*.youtube.com/shorts*",
        "https://youtube.com/shorts*",
        "https://*.youtube.com/embed/*",
        "https://*.youtube.com/live*",
        "https://youtube.com/live*"
