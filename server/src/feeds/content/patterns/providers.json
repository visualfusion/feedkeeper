  "snapshot_date": "2026-11-23",
  "providers": [
    {
      "provider_name": "Bluesky Social",
      "schemes": [
        "https://bsky.app/profile/*/post/*"
      ],
      "item_paths": [
        "^/profile/[^/]+/post/[^/]+/?$"
      ]
    },
    {
      "provider_name": "Dailymotion",
      "schemes": [
        "https://www.dailymotion.com/video/*"
